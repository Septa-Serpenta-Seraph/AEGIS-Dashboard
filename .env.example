# AEGIS Dashboard Configuration
# Copy this file to .env and fill in your values

# OpenRouter API Key (required for supervisor chat and model metrics)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Discord Webhook URL (optional - for pushing scan results to Discord)
# Create one in: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# TryHackMe API Key (optional - for THM profile integration)
# Find yours at: https://tryhackme.com/profile (scroll to API section)
TRYHACKME_API_KEY=

# TryHackMe VPN Config (optional - for THM network access)
# Download your .ovpn config from: https://tryhackme.com/access
# Place it in the project root as thm_config.ovpn
# This file is gitignored - you must provide your own

# Flask Settings
FLASK_ENV=development
DASH_PORT=5000
